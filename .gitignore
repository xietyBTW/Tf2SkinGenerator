# ══════════════════════════════════════════════════════════════
#  Tf2SkinGenerator — .gitignore
#  В репозитории: исходный код, src/, tools/mod_data, конфиги-шаблоны
#  НЕ в репозитории: сборка, бинари, IDE, временные файлы
# ══════════════════════════════════════════════════════════════

# ── Python runtime ────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo

# ── Тесты / покрытие ──────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.json
coverage_baseline.json
htmlcov/
mainTest.py
run_test.bat

# ── Сборка (PyInstaller / distutils) ─────────────────────────
build/
dist/
*.spec

# ── Скрипты сборки и установщик (не нужны пользователям) ─────
*.bat
*.ps1
installer/

# ── Временные выходные папки ──────────────────────────────────
out/
export/
exportTest/

# ── Конфигурация с машинными путями ──────────────────────────
# Коммитить только примеры: config/*.example.json
config/*.json
!config/*.example.json

# ── Инструменты: временные и генерируемые папки ───────────────
tools/temp/
tools/temp_vmt_extract/
tools/edited_vmt/
tools/backupVMT/

# ── Инструменты: сторонние бинари ─────────────────────────────
# Лицензии/источники см. THIRD_PARTY_LICENSES.md
# crowbar (CC BY-SA 3.0) и VTF-тулзы (VTFLib LGPL / VTFCmd GPL) — в репозитории:
# их лицензии разрешают редистрибуцию (и они всё равно попадают в релиз).
# vpk.exe — вне репо: он проприетарный Valve, берётся из bin установленной TF2.
tools/VPK/

# ── Ассеты Valve/TF2: НЕ распространяются (чужой copyright) ────
# Модели/текстуры берутся из локальной установки игры пользователя.
# Папки-заглушки сохраняются через .gitkeep.
tools/Model/**/*.vtf
tools/Model/**/*.obj
tools/Model/**/*.smd
tools/Model/**/*.dmx
tools/Model/**/*.mdl
tools/Model/**/*.qc
tools/mod_data/*.pcf
tools/mod_data/*.vmt
tools/mod_data/*.vtf

# ── Логи и мусорные файлы ────────────────────────────────────
*.log
*.tmp
# Только мусорные txt (тестовые артефакты)
out.txt
err.txt
test_*.txt
*_err.txt

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
.claude/

# ── OS ────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
*.lnk
.DS_Store
cache/hats_cache.json
/cache
