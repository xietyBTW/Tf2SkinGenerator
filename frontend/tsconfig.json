{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strictNullChecks": false
  },
  "include": [
    "mockup/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
